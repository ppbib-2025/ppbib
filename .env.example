# ── Instagram Graph API (via Facebook App) ──────────────────────
# Cara isi: buat app di https://developers.facebook.com → tipe Bisnis
# → tambah produk "Instagram Graph API" → salin App ID & Secret ke sini.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Samakan persis dengan "Valid OAuth Redirect URIs" di setting Facebook App.
# Produksi: https://ppbib.web.id/instagram/callback
INSTAGRAM_REDIRECT_URI=https://ppbib.web.id/instagram/callback
