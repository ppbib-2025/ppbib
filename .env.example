# Salin file ini menjadi .env lalu isi nilai-nilainya
# cp .env.example .env

# ── TikTok API ────────────────────────────────────────────────────────────────
# Buat app di: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5000/callback

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Nomor WA bisnis kamu (format: 628xxx tanpa + atau -)
WHATSAPP_NUMBER=628

# ── Anthropic / Claude AI ─────────────────────────────────────────────────────
# Dapatkan API key di: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-
